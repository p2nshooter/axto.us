// axto.us — a static site served by Cloudflare Workers Static Assets.
// There is no Worker script and no database: every page is plain HTML built
// from sites/axto.us by sites/_engine/build.mjs. The custom domain axto.us is
// already attached to this Worker ("axto-us"), so deploying keeps it.
{
  "name": "axto-us",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./sites/axto.us/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
